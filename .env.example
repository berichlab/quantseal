# ==============================================================================
# QuantSeal — Self-Hosted Anti-Overfitting Autonomous Quant Research Lab
# Copy this file to .env (or configure variables in Hostinger Docker Manager)
# ==============================================================================

# --- Security & Access ---
# Set a strong password to protect the web dashboard and API.
# Leave empty ONLY for local non-exposed development (prints a warning on boot).
QUANTSEAL_ADMIN_PASSWORD=change-me-to-a-strong-password
# Optional random secret for signing auth cookies (auto-generated and persisted in /data if empty)
QUANTSEAL_SECRET_KEY=

# --- Storage ---
# Persistent directory for SQLite DB, immutable frozen snapshots, and campaign ledgers
QUANTSEAL_DATA_DIR=/data
# Optional: override with PostgreSQL connection string, e.g. postgresql+psycopg://user:pass@postgres:5432/quantseal
QUANTSEAL_DATABASE_URL=

# --- First-Boot Experience ---
# Automatically seeds a deterministic multi-asset demo campaign and 3 shadow strategies on an empty DB
QUANTSEAL_AUTO_DEMO=true

# --- Market Data & Cost Defaults ---
# Presets: us_equities | crypto_spot | tw_equities | custom
QUANTSEAL_DEFAULT_MARKET_PRESET=us_equities
# Default symbols used by scheduled runs (comma-separated)
QUANTSEAL_DEFAULT_SYMBOLS=SPY,QQQ,IWM,XLK,XLF,XLE,XLV,XLI,XLP,XLY,GLD,TLT

# --- BYOK LLM Provider (Optional — enables autonomous hypothesis proposals) ---
# Providers: none | openai | anthropic | gemini | openai_compatible
QUANTSEAL_LLM_PROVIDER=none
QUANTSEAL_LLM_API_KEY=
QUANTSEAL_LLM_MODEL=gpt-4o-mini
# Required only for openai_compatible (e.g., https://openrouter.ai/api/v1 or http://ollama:11434/v1)
QUANTSEAL_LLM_BASE_URL=

# --- 24/7 Background Scheduler ---
QUANTSEAL_SCHEDULER_ENABLED=true
# Cron (UTC) for daily shadow forward evaluation & ladder reconciliation (default: 22:00 UTC)
QUANTSEAL_SHADOW_CRON=0 22 * * 1-5
# Optional cron (UTC) for weekly autonomous campaign cycle (leave empty to disable automatic campaigns)
QUANTSEAL_CAMPAIGN_CRON=

# --- Notifications (Optional) ---
QUANTSEAL_TELEGRAM_BOT_TOKEN=
QUANTSEAL_TELEGRAM_CHAT_ID=
QUANTSEAL_DISCORD_WEBHOOK_URL=
QUANTSEAL_GENERIC_WEBHOOK_URL=

# --- External MCP Connectors ---
# Remote HTTP/SSE MCP servers are always supported. Keep local stdio disabled on public VPS.
QUANTSEAL_ALLOW_STDIO_MCP=false
